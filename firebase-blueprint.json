{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Store main user information",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Full name of the user"
        },
        "email": {
          "type": "string",
          "description": "Verified email address of the user"
        },
        "address": {
          "type": "string",
          "description": "Default delivery address text"
        }
      },
      "required": ["name", "email"]
    },
    "UserAddress": {
      "title": "UserAddress",
      "description": "Physical shipping addresses profile for the customer",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string" },
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "pincode": { "type": "string" },
        "villCity": { "type": "string" },
        "state": { "type": "string" },
        "district": { "type": "string" },
        "country": { "type": "string" },
        "countryCode": { "type": "string" },
        "isDefault": { "type": "boolean" }
      },
      "required": ["id", "type", "name", "phone", "pincode", "villCity"]
    },
    "UserCartItem": {
      "title": "UserCartItem",
      "description": "Items placed in the checkout cart",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "price": { "type": "number" },
        "quantity": { "type": "number" },
        "kgQuantity": { "type": "number" },
        "gmQuantity": { "type": "number" },
        "image": { "type": "string" },
        "category": { "type": "string" }
      },
      "required": ["id", "name", "price", "quantity"]
    },
    "UserWishlistItem": {
      "title": "UserWishlistItem",
      "description": "Products liked/wishlisted by user",
      "type": "object",
      "properties": {
        "productId": { "type": "string" }
      },
      "required": ["productId"]
    },
    "UserOrder": {
      "title": "UserOrder",
      "description": "E-commerce order history details",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "date": { "type": "string" },
        "total": { "type": "number" },
        "status": { "type": "string" }
      },
      "required": ["id", "date", "total", "status"]
    },
    "ProductReview": {
      "title": "ProductReview",
      "description": "Reviews and ratings posted by users for products",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "productId": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "userImage": { "type": "string" },
        "rating": { "type": "number" },
        "comment": { "type": "string" },
        "createdAt": { "type": "number" },
        "isVerified": { "type": "boolean" },
        "helpfulCount": { "type": "number" }
      },
      "required": ["id", "productId", "userId", "userName", "rating", "comment", "createdAt"]
    }
  },
  "firestore": {
    "/reviews/{reviewId}": {
      "schema": { "$ref": "ProductReview" },
      "description": "Product reviews collection"
    },
    "/users/{userId}": {
      "schema": { "$ref": "UserProfile" },
      "description": "Stores user profiles"
    },
    "/users/{userId}/addresses/{addressId}": {
      "schema": { "$ref": "UserAddress" },
      "description": "Addresses collection for users"
    },
    "/users/{userId}/cart/{itemId}": {
      "schema": { "$ref": "UserCartItem" },
      "description": "Cart items subcollection"
    },
    "/users/{userId}/wishlist/{productId}": {
      "schema": { "$ref": "UserWishlistItem" },
      "description": "Wishlist items subcollection"
    },
    "/users/{userId}/orders/{orderId}": {
      "schema": { "$ref": "UserOrder" },
      "description": "Order history subcollection"
    }
  }
}
